---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Img from '../../components/Img.astro';
import CtaBand from '../../components/CtaBand.astro';
import type { MediaId } from '../../lib/media';
import { crumbSchema } from '../../lib/site';

const posts = (await getCollection('journal')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const crumbs = [{ label: 'Journal', href: '/journal/' }];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Journal: Organization & Move-In Advice | Home Harmonics"
  description="Practical thinking on home organization, move-ins, custom cabinetry and working with designers, written by Yaz Scott of Home Harmonics."
  schema={[crumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Journal"
    title="Notes from | *the work.*"
    lead="Practical thinking on organization, move-ins and the way a household runs, written by Yaz."
    crumbs={crumbs}
  />

  <Section bg="alabaster" class="jn">
    <div class="wrap">
      <ol role="list" class="jn-list">
        {posts.map((p) => (
          <li data-reveal>
            <a class="jn-row" href={`/journal/${p.id}/`}>
              <Img id={p.data.hero as MediaId} class="jn-img" alt="" sizes="(min-width: 1024px) 28vw, 100vw" widths={[480, 720, 960]} />
              <span class="jn-text">
                <span class="eyebrow muted"><time datetime={p.data.published.toISOString().slice(0, 10)}>{fmt(p.data.published)}</time></span>
                <span class="h3 jn-title">{p.data.title}</span>
                <span class="muted">{p.data.description}</span>
                <span class="link">Read <span class="arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <CtaBand from="alabaster" />
</Base>

<style is:global>
  .jn-list { border-top: var(--rule); }
  .jn-list > li { border-bottom: var(--rule); }
  .jn-row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding: clamp(32px, 4vw, 56px) 0; text-decoration: none; }
  .jn-img { aspect-ratio: 3 / 2; }
  .jn-text { display: grid; gap: 14px; justify-items: start; max-width: 40rem; }
  .jn-title { background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px; transition: background-size 700ms var(--ease); }
  .jn-row:hover .jn-title { background-size: 100% 1px; }
  @media (max-width: 767px) { .jn-row { grid-template-columns: 1fr; } }
</style>
