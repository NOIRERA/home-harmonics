---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Img from '../components/Img.astro';
import Words from '../components/Words.astro';
import { settings, crumbSchema } from '../lib/site';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

const crumbs = [{ label: 'For the Trade', href: '/trade/' }];
const offer = [
  { t: 'Post-install organization', d: 'New cabinetry, closets and pantries set up and labeled the way you designed them to be used.' },
  { t: 'Move-in completion', d: 'Your client’s belongings unpacked into the finished home, so the reveal is a home, not a set of boxes.' },
  { t: 'Client handoff', d: 'A walkthrough and a care guide for the household, delivered with your studio or company name alongside ours.' },
  { t: 'Wardrobe and pantry setup', d: 'The two spaces clients touch every day, edited and zoned around how they live.' },
  { t: 'Project support', d: 'Sourcing lists and product specifications sized to your cabinetry, prepared before handover.' },
  { t: 'Out-of-market projects', d: 'Your project is in another city. We come to you, by arrangement, with travel and lodging at cost.' },
];
const roles = ['Interior designer', 'Architect', 'Builder', 'Realtor', 'Relocation specialist', 'Household manager', 'Other'];
---
<Base
  title="For Designers, Builders & Realtors | Home Harmonics"
  description="Post-install organization, move-in completion and co-branded client handoff for designers, architects, builders and realtors in Dallas–Fort Worth."
  schema={[crumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="For the trade"
    title="You create the home. | *We make it beautifully livable.*"
    lead="Organization, move-in completion and client handoff for interior designers, architects, custom builders, realtors, relocation specialists and household managers."
    img="laundry"
    crumbs={crumbs}
  >
    <a class="btn" href="#trade-inquiry">Start a trade inquiry</a>
  </PageHero>

  <Section bg="alabaster" class="tr-offer">
    <div class="wrap">
      <header class="sec-head">
        <p class="eyebrow">What we take on</p>
        <h2 class="h2"><Words reveal text="The last mile *of a beautiful project.*" /></h2>
      </header>
      <ul role="list" class="cols-3 tr-grid">
        {offer.map((o) => <li data-reveal><h3 class="h3">{o.t}</h3><p class="muted">{o.d}</p></li>)}
      </ul>
    </div>
  </Section>

  <Section bg="limestone" from="alabaster" class="tr-how">
    <div class="wrap split">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="h2"><Words reveal text="Your client, *your credit.*" /></h2>
        <Img id="closet" class="tr-img" reveal="mask" sizes="(min-width: 1024px) 30vw, 100vw" widths={[480, 720, 1000]} />
      </div>
      <ol role="list" class="steps">
        <li data-reveal><span class="steps-n" aria-hidden="true">01</span><div><h3 class="h3">Introduce the project</h3><p class="muted">Send a trade inquiry or call. Yaz replies the same day.</p></div></li>
        <li data-reveal><span class="steps-n" aria-hidden="true">02</span><div><h3 class="h3">Walk it together</h3><p class="muted">A walkthrough with you and your client, in person or by video, before handover.</p></div></li>
        <li data-reveal><span class="steps-n" aria-hidden="true">03</span><div><h3 class="h3">Install and hand over</h3><p class="muted">Spaces organized, labeled and handed to your client with a care guide.</p></div></li>
        <li data-reveal><span class="steps-n" aria-hidden="true">04</span><div><h3 class="h3">Credit stays shared</h3><p class="muted">The handoff is co-branded by default. White-label is available on request. Nothing is photographed without written consent.</p></div></li>
      </ol>
    </div>
  </Section>

  <Section bg="walnut" from="limestone" id="trade-inquiry" class="tr-form-band" data-hide-cta="">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Trade inquiry</p>
        <h2 class="h2"><Words reveal text="Tell us about *the project.*" /></h2>
        <p class="muted">Yaz replies the same day. Prefer to talk? Call or text <a href={`tel:${settings.phoneE164}`}>{settings.phone}</a>.</p>
      </div>
      <form class="inq-form" method="post" action="/api/trade/" data-inquiry data-phone={settings.phone}>
        <div class="field"><label for="t-name">Name</label><input id="t-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="t-firm">Firm</label><input id="t-firm" name="firm" autocomplete="organization" required /></div>
        <div class="field"><label for="t-email">Email</label><input id="t-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="t-phone">Phone</label><input id="t-phone" name="phone" type="tel" autocomplete="tel" required /></div>
        <div class="field select">
          <label for="t-role">Role</label>
          <select id="t-role" name="role" required>
            <option value="" selected disabled>Choose one</option>
            {roles.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field"><label for="t-location">Project location</label><input id="t-location" name="location" required /></div>
        <div class="field full"><label for="t-timeline">Project timeline</label><input id="t-timeline" name="timeline" required /></div>
        <div class="field full"><label for="t-note">Short note <span class="opt">(optional)</span></label><textarea id="t-note" name="note" rows="4"></textarea></div>
        <div class="hp" aria-hidden="true"><label for="t-company">Company</label><input id="t-company" name="company" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="page" data-page />
        {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile full" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-appearance="interaction-only"></div>}
        <div class="form-foot">
          <button class="btn" type="submit">Send trade inquiry</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </Section>
</Base>

<style is:global>
  @media (min-width: 1024px) {
    .tr-grid > li:nth-child(n + 4) { border-top: var(--rule); }
    .tr-grid > li:nth-child(4) { border-left: 0; padding-left: 0; }
  }
  .tr-img { width: 100%; aspect-ratio: 4 / 5; max-width: 420px; margin-top: 16px; }
</style>
