---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Img from '../../components/Img.astro';
import CtaBand from '../../components/CtaBand.astro';
import { media, type MediaId } from '../../lib/media';
import { crumbSchema } from '../../lib/site';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props as { p: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> };
const d = p.data;
for (const id of [d.before, d.after]) {
  if (!(id in media)) throw new Error(`Project ${p.id}: unknown media id ${id}`);
  // Plan §0.2: only real client work inside case studies.
  if (media[id as MediaId].truth !== 'real_client_work') throw new Error(`Project ${p.id}: ${id} is not real client work`);
}
const before = d.before as MediaId;
const after = d.after as MediaId;
const crumbs = [{ label: 'Work', href: '/work/' }, { label: d.title, href: `/work/${p.id}/` }];
const portrait = media[after].src.height > media[after].src.width;
---
<Base title={`${d.title} — ${d.space} | Home Harmonics`} description={d.summary} schema={[crumbSchema(crumbs)]}>
  <PageHero eyebrow={d.space} title={d.title} lead={d.summary} crumbs={crumbs}>
    <span class="eyebrow muted">{[...d.scope, d.duration].filter(Boolean).join(' · ')}</span>
  </PageHero>

  <Section bg="alabaster" class="cs-pair">
    <div class:list={['wrap', 'ba', portrait && 'ba-portrait']}>
      <figure data-reveal>
        <Img id={before} sizes="(min-width: 1024px) 45vw, 100vw" widths={[480, 720, 960, 1448]} />
        <figcaption class="eyebrow muted">Starting point</figcaption>
      </figure>
      <span class="ba-arrow" aria-hidden="true">→</span>
      <figure data-reveal style="--delay:150ms">
        <Img id={after} sizes="(min-width: 1024px) 45vw, 100vw" widths={[480, 720, 960, 1448]} />
        <figcaption class="eyebrow">Result</figcaption>
      </figure>
    </div>
  </Section>

  <Section bg="limestone" from="alabaster" class="cs-story">
    <div class="wrap split">
      <div>
        <div class="cs-block" data-reveal>
          <p class="eyebrow">Starting point</p>
          <p class="cs-p">{d.challenge}</p>
        </div>
        <div class="cs-block" data-reveal>
          <p class="eyebrow">Approach</p>
          <p class="cs-p">{d.strategy}</p>
        </div>
      </div>
      <div class="cs-lists">
        <div data-reveal>
          <p class="eyebrow">Systems</p>
          <ul role="list" class="ticks">{d.systems.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div data-reveal>
          <p class="eyebrow">Result</p>
          <ul role="list" class="ticks">{d.results.map((x) => <li>{x}</li>)}</ul>
        </div>
        {d.detail && (
          <Img id={after} class="cs-detail" reveal="mask" alt={d.detail.alt} zoom={d.detail.zoom} origin={d.detail.origin} sizes="(min-width: 1024px) 24vw, 70vw" widths={[480, 720, 1000]} />
        )}
        <p class="muted cs-credit">{d.credit}. Shared with the client’s written permission.</p>
      </div>
    </div>
  </Section>

  <Section bg="alabaster" from="limestone" class="cs-next">
    <div class="wrap cs-next-in">
      <a class="link" href="/work/"><span class="arrow" aria-hidden="true">←</span> All work</a>
      {next.id !== p.id && (
        <a class="cs-next-link" href={`/work/${next.id}/`}>
          <span class="eyebrow muted">Next project</span>
          <span class="h2">{next.data.title}</span>
        </a>
      )}
    </div>
  </Section>

  <CtaBand from="alabaster" />
</Base>

<style is:global>
  .ba { display: grid; grid-template-columns: 1fr auto 1fr; gap: clamp(16px, 3vw, 40px); align-items: center; }
  .ba figure { display: grid; gap: 14px; }
  .ba .img { aspect-ratio: 4 / 3; }
  .ba-portrait { max-width: 1040px; }
  .ba-portrait .img { aspect-ratio: 9 / 16; }
  .ba-arrow { font: 300 2rem/1 var(--serif); color: var(--taupe); }
  .cs-block + .cs-block { margin-top: 40px; }
  .cs-block .eyebrow { margin-bottom: 12px; }
  .cs-p { font: 300 clamp(1.25rem, 1.05rem + 0.7vw, 1.75rem)/1.45 var(--serif); max-width: 34rem; }
  .cs-lists { display: grid; gap: 40px; }
  .cs-lists .eyebrow { margin-bottom: 12px; }
  .cs-detail { aspect-ratio: 4 / 5; max-width: 320px; }
  @media (max-width: 767px) { .cs-detail { max-width: 240px; } }
  .cs-credit { font-size: 0.875rem; }
  .cs-next-in { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 32px; }
  .cs-next-link { display: grid; gap: 12px; text-align: right; text-decoration: none; }
  .cs-next-link .h2 { background: linear-gradient(currentColor, currentColor) no-repeat 100% 100% / 0 1px; transition: background-size 700ms var(--ease); }
  .cs-next-link:hover .h2 { background-size: 100% 1px; }
  @media (max-width: 767px) {
    .ba { grid-template-columns: 1fr 1fr; }
    .ba-arrow { display: none; }
    .cs-next-link { text-align: left; }
  }
</style>
