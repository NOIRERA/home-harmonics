---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Img from '../../components/Img.astro';
import CtaBand from '../../components/CtaBand.astro';
import type { MediaId } from '../../lib/media';
import { crumbSchema } from '../../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ label: 'Work', href: '/work/' }];
---
<Base
  title="Selected Work: Real Home Organization Projects | Home Harmonics"
  description="Real home organization projects by Home Harmonics, photographed on site and shared with each client’s written permission."
  schema={[crumbSchema(crumbs)]}
>
  <PageHero
    eyebrow="Work"
    title="Real homes, | *shared with consent.*"
    lead="A selection of recent projects, photographed on site and shared with each client’s written permission."
    crumbs={crumbs}
  />

  <Section bg="alabaster" class="wk">
    <div class="wrap">
      <ol role="list" class="wk-list">
        {projects.map((p, i) => (
          <li>
            <a class:list={['wk-row', i % 2 === 1 && 'flip']} href={`/work/${p.id}/`}>
              <Img id={p.data.after as MediaId} class="wk-img" reveal="mask" alt={`${p.data.title}: the finished ${p.data.space.toLowerCase()}`} position={p.data.cover} sizes="(min-width: 1024px) 50vw, 100vw" widths={[640, 960, 1280]} />
              <span class="wk-text" data-reveal>
                <span class="eyebrow muted">0{i + 1} · {p.data.space}{p.data.duration && ` · ${p.data.duration}`}</span>
                <span class="h2 wk-title">{p.data.title}</span>
                <span class="muted measure">{p.data.summary}</span>
                <span class="link">View the project <span class="arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="wk-note muted" data-reveal>Many of our homes are never photographed. Fuller walk-throughs are shared during consultation.</p>
    </div>
  </Section>

  <CtaBand from="alabaster" />
</Base>

<style is:global>
  .wk-list { display: grid; gap: clamp(80px, 10vw, 160px); }
  .wk-row { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 112px); align-items: center; text-decoration: none; }
  .wk-row.flip .wk-img { order: 2; }
  .wk-img { aspect-ratio: 4 / 5; max-height: 82vh; }
  .wk-text { display: grid; gap: 20px; justify-items: start; }
  .wk-title { background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px; transition: background-size 700ms var(--ease); }
  .wk-row:hover .wk-title { background-size: 100% 1px; }
  .wk-note { margin-top: clamp(80px, 10vw, 140px); max-width: 34rem; font-family: var(--serif); font-style: italic; font-size: 1.25rem; }
  @media (max-width: 1023px) { .wk-row { grid-template-columns: 1fr; } .wk-row.flip .wk-img { order: 0; } .wk-img { aspect-ratio: 4 / 3; } }
</style>
